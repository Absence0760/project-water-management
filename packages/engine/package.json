{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@water-management/engine",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "Pure TypeScript water-balance model. No I/O, no DB, no DOM — runs in the browser and in Lambda.",
	"exports": {
		".": "./src/index.ts",
		"./calendar": "./src/calendar.ts",
		"./dws": "./src/dws.ts",
		"./format": "./src/format.ts",
		"./languages": "./src/languages.ts",
		"./legal": "./src/legal.ts",
		"./limitations": "./src/liability/limitations.generated.ts",
		"./methodology": "./src/liability/methodology-text.generated.ts",
		"./provenance": "./src/seriesProvenance.ts",
		"./testing": "./src/testing/index.ts",
		"./version": "./src/version.ts",
		"./zip": "./src/zip/index.ts"
	},
	"scripts": {
		"check": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run --project unit",
		"test:watch": "vitest",
		"test:perf": "vitest run --project perf",
		"gen:liability": "tsx scripts/gen-liability.ts"
	},
	"devDependencies": {
		"@types/node": "24.19.0",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"vitest": "^5.0.2"
	}
}
