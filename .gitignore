.tox/

# Environment / secrets. Real production secrets do NOT live in project repos —
# they live in the private `infra-secrets` repo (see CLAUDE.md "Secrets").
# Committed `.env.development` (non-sensitive local defaults; see CLAUDE.md) is
# NOT matched here, so it stays tracked. Machine-local real values go in the
# gitignored `.env.development.local` (caught by `.env.*.local`).
.env
.env.local
.env.*.local
!.env.example
!.env.*.example

# Guard: no SOPS-encrypted secrets in a project repo (they belong in infra-secrets).
*.sops
*.sops.yaml
!*.sops.yaml.example

# Terraform
.terraform/
*.tfstate
*.tfstate.*
# Saved plans hold decrypted secrets (sops values, passwords) in plain form.
# infra/README.md writes them outside the repo; this is the backstop.
*.tfplan
*.tfplan.json
*.tfvars
!*.tfvars.example
.terraform.lock.hcl.bak
crash.log

# Partial-backend config — embeds account-id in the bucket name, so
# templates that use the bootstrap-aware partial-backend pattern keep
# the per-account value out of git. Bare name matches the file at any
# depth (infra/backend.config, web/infra/backend.config, etc.).
backend.config

# AWS SAM / serverless
.aws-sam/
.serverless/

# Python misc
.python-version

# Sanity
.sanity/

# Local dev infra
.localstack/

# Persona audit reports
# `.claude/agents/personas/persona-*.md` auditors write their findings here. The reports
# are per-clone working notes (often half-reconciled), never a committed
# artifact — but the folder's README documents the convention, so keep that one
# file tracked via the negation below. Glob the contents (`/reviews/*`), not the
# directory (`/reviews/`) — git won't descend into an ignored directory, so a
# directory-level ignore would defeat the negation.
/reviews/*
!/reviews/README.md

# Source Excel workbooks (large, client data) — kept locally, never committed.
# Tests use small fixtures extracted from them (see docs/model.md).
*.xlsm
*.xlsx
# The exceptions: the SYNTHETIC b023 workbook (an invented catchment, made by
# scripts/wbt-import/make_synthetic_workbook.py) that the importer parity tests read,
# and the hand-written string-decoding workbook (invented text, made by
# scripts/wbt-import/make_string_decoding_fixture.py).
!/scripts/wbt-import/fixtures/synthetic_b023.xlsx
!/scripts/wbt-import/fixtures/string_decoding.xlsx
# The workbooks now live outside the repo (../project-water-management-source/);
# keep these as a safety net in case they're copied back in.
Original/
AI/
data/
.venv-brand/
.claude/worktrees/
