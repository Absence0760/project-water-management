# Copy to terraform.tfvars (gitignored) — or, per the estate pattern, keep the
# canonical copy in the private repo as infra-secrets/water-management/prod.tfvars
# and pass it with -var-file (infra/README.md § First apply). Nothing here is
# secret; secrets come from infra-secrets/water-management/prod.sops.yaml
# through infra/scripts/tf.sh (ephemeral variables, secrets.tf), never from
# tfvars.

# Primary region for VPC/RDS/Lambda/S3. af-south-1 (Cape Town) for POPIA +
# latency — enable it on the account first (Account → AWS Regions) — or
# us-east-1 for the lowest price. See infra/README.md § Region.
# This is the workload region only: the tfstate bucket and the sops KMS key
# are always in us-east-1 (main.tf's backend), so the account bootstrap runs
# with region = "us-east-1" whatever this says (infra/README.md step 1).
aws_region = "af-south-1"

# The bootstrap's delegated child zone.
domain_name = "water-management.jaredhoward.com"

# Child zone ID from the bootstrap summary, or:
#   aws route53 list-hosted-zones-by-name --dns-name water-management.jaredhoward.com --profile water-management
route53_zone_id = "Z0000000000000000000"

github_repo = "Absence0760/project-water-management"

# MUST match the slug new-project-account.sh was run with (role <slug>-deploy).
bootstrap_slug = "water-management"

# No runtime_secret_version here: scripts/tf.sh derives it from
# prod.sops.yaml's sops.lastmodified, so every sops edit rotates the runtime
# secrets, and it refuses a var file that sets it (docs/deployment.md §
# Rotating a secret). The sops file's own path is tf.sh's WM_SECRETS_FILE
# (default: the infra-secrets sibling clone).

# Budget + alarm notifications. Budgets need IAM billing access enabled on the
# member account (one-time root toggle) — set budget_monthly_usd to 0 until
# then.
# 80 (the default) for af-south-1 (idle ≈ $58–63; ACTUAL 80% = $64); ~60 in
# us-east-1. Full tier: ~170 (docs/deployment-tiers.md).
budget_monthly_usd = 80
# Daily ACTUAL budget, the first-month guard (the monthly forecast needs ~5
# weeks of history). Unset = ceil(monthly × 2.25 / 30) = $6 on $80, ~3× idle;
# 0 skips it. Must be below budget_monthly_usd.
# budget_daily_usd = 6
# Cost Anomaly Detection: page on an anomaly of at least this many USD. 0 (the
# default) skips it. Leave it off for the first apply: an account holds one
# services monitor and AWS may already have made it. Turn it on afterwards
# (infra/README.md § Operator steps, step 11: check for an existing monitor,
# import it if there is one, then set 10 and apply).
# cost_anomaly_threshold_usd = 10
# Required. Replace the placeholder: plan refuses an empty, malformed or
# reserved address (example.com/.org/.net, .example, .test, .invalid,
# .localhost), so an unedited copy of this file fails before it can page nobody.
budget_alert_email = "you+aws-alerts@example.com"

# Lambda concurrency caps. A new account's concurrency quota is 10 and AWS
# keeps 10 unreserved, so ANY reservation fails until the quota is raised:
# raise it BEFORE the first apply to at least the sum of these + 10 (33 at the
# defaults; ask for 1000: infra/README.md § Operator steps). -1 (unreserved)
# is refused: it lifts the spend and DB-connection caps.
lambda_reserved_concurrency  = 10
migrate_reserved_concurrency = 1
# worker_reserved_concurrency   = 8 # at least 8: its four SQS triggers x 2
# fetcher_reserved_concurrency  = 2
# renderer_reserved_concurrency = 2

# Database sizing (defaults shown).
# db_instance_class           = "db.t4g.micro"
# db_allocated_storage_gb     = 20
# db_max_allocated_storage_gb = 50
# db_backup_retention_days    = 7
# db_multi_az                 = false

# Email (SES, ses.tf). Mail goes out as no-reply@<domain_name>.
# DMARC starts at p=none; set a report mailbox, read a few weeks of reports,
# then move to quarantine (docs/deployment.md § Email). Empty omits rua; a
# set value is held to budget_alert_email's rule, so replace the placeholder.
dmarc_report_email = "you+dmarc@example.com"
# dmarc_policy          = "none"
# ses_tls_policy        = "REQUIRE"
# ses_endpoint_az_count = 1

# CloudFront price class. Only PriceClass_All has South African edges;
# PriceClass_100/200 serve SA users from Europe or Asia.
# cloudfront_price_class = "PriceClass_All"

# WAF: requests per IP per 5-minute window on /api/* (auth endpoints have a
# fixed, tighter 100). AWS min 100.
waf_rate_limit_per_ip = 1000
# ...and on every path, the static site's backstop (at least the /api/*
# limit; waf.tf). The SPA's files don't count against the API's limit.
# waf_site_rate_limit_per_ip = 5000

# Request-flood alarm (us-east-1): CloudFront requests per 5 minutes, ~20x a
# busy 5 minutes for a handful of users. 1000-20000; raise it only for real
# growth (infra/README.md § Cost).
# cloudfront_requests_alarm_per_5min = 5000

# Report downloads (reports.tf): the CloudFront public keys trusted to sign
# them, name -> PEM, and the one whose private half is cloudfront_private_key
# in prod.sops.yaml. Public keys, not secrets: `openssl pkey -in <key> -pubout`
# (infra/prod.sops.yaml.example). Two entries only while a rotation overlaps
# (docs/deployment.md § Rotating a secret).
report_download_public_keys = {
  "2026-09" = <<-EOT
    -----BEGIN PUBLIC KEY-----
    REPLACE_ME
    -----END PUBLIC KEY-----
  EOT
}
report_download_signing_key = "2026-09"

# Failed-sign-in alarm: failed credential checks per 15 minutes across all
# accounts (password spraying). 10-300; raise it with the number of users
# (docs/deployment.md § Runbooks, Credential stuffing).
# login_failed_alarm_per_15min = 30

# Sign-in CAPTCHA (waf.tf SignInCaptchaPerIP): past this many sign-ins per IP
# in 5 minutes the WAF asks for a puzzle (10-99, below the auth block's 100).
# COUNT switches the puzzle off but keeps counting (the runbook's switch-off).
# waf_signin_captcha_per_5min = 20
# waf_signin_captcha_action   = "CAPTCHA"
#
# The account's CAPTCHA integration URL (not a secret), from:
#   aws wafv2 list-api-keys --scope CLOUDFRONT --region us-east-1 --query ApplicationIntegrationURL --output text
# Empty: the CSP allows no WAF origin and the sign-in page says to wait
# instead of showing the puzzle.
# waf_captcha_integration_url = "https://<id>.edge.captcha-sdk.awswaf.com/<id>/"
