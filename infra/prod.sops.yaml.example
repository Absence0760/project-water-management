# Key list for infra-secrets/water-management/prod.sops.yaml (PRIVATE estate
# repo — never create the real file in this public repo). Flat keys, every
# value a quoted string (the PEM key below: a block scalar). infra/scripts/tf.sh hands each one to Terraform as
# the ephemeral variable of the same name (TF_VAR_<key>, via sops exec-env);
# Terraform keeps them out of state (infra/secrets.tf).
#
# Create / edit (authenticated to the water-management account):
#   cd ~/github/infra-secrets && AWS_PROFILE=water-management sops water-management/prod.sops.yaml
#
# After ANY edit, plan and apply through tf.sh. The runtime secrets are
# written write-only, so Terraform can't see a changed value by itself; tf.sh
# sets runtime_secret_version from this file's sops.lastmodified (plaintext
# metadata sops rewrites on every edit), so the edit alone triggers the
# rewrite (docs/deployment.md § Rotating a secret).
#
# The RDS master (schema-owner) password is NOT here: RDS manages and rotates
# it in Secrets Manager (infra/rds.tf). The CloudFront shared secret is
# Terraform-generated (random_password) and is not here either.

# Signs the wm_session JWT (HS256). >= 32 chars. `openssl rand -hex 32`
auth_jwt_secret: "REPLACE_ME"

# Password for the RLS-bound runtime role water_app. 24+ ALPHANUMERIC chars
# only (it is embedded in DATABASE_URL). `openssl rand -hex 24`
# The migrate Lambda sets it on the role on every invocation. Rotating is:
# edit here -> apply through tf.sh -> immediately invoke the migrate Lambda
# (infra/README.md § Rotating secrets); the API fails DB logins in between.
db_app_password: "REPLACE_ME"

# Signs the one-click unsubscribe links in alert emails (the worker only).
# 32+ ALPHANUMERIC chars. `openssl rand -hex 32`
# Rotating breaks the unsubscribe link in every alert already sent ("Manage
# your alerts" still works), so rotate only if it leaked.
alerts_token_secret: "REPLACE_ME"

# Signs report download links (CloudFront signed URLs, infra/reports.tf; the
# API only): an RSA 2048 private key, PEM, as a block scalar. Generate it
# outside any repo, put it here, put its PUBLIC half in prod.tfvars
# (report_download_public_keys + report_download_signing_key), then delete
# the file:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out report-downloads.key
#   openssl pkey -in report-downloads.key -pubout
# The API refuses to start if this key and the signing public key aren't a
# pair. Rotating (two keys overlap, no failed downloads): docs/deployment.md
# § Rotating a secret.
cloudfront_private_key: |
  REPLACE_ME

# Seals two-step sign-in's TOTP secrets at rest (the API only;
# backend/src/auth/secretBox.ts). 32+ ALPHANUMERIC chars. `openssl rand -hex 32`
# Rotating it voids every enrolled authenticator: each person must set theirs
# up again (the operator clears user_totp first; docs/security.md § Two-step
# sign-in), so rotate only if it leaked.
app_encryption_key: "REPLACE_ME"
