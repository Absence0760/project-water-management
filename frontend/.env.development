# URL of the backend API (must be reachable from the browser).
# In local development this is the Hono dev server.
# In prod this is `/api` — CloudFront proxies same-origin /api/* requests
# to the Lambda Function URL with the shared secret (see infra/s3_cloudfront.tf).
PUBLIC_API_URL=http://localhost:3001

# The sign-in CAPTCHA (src/lib/auth/wafCaptcha.ts): off locally, since there is
# no WAF to ask for it. deploy-frontend.yml sets both from Terraform outputs.
PUBLIC_WAF_CAPTCHA_SCRIPT_URL=
PUBLIC_WAF_CAPTCHA_API_KEY=

# The catchment map's basemap (issue #288, docs/maps.md § Basemap): a PMTiles file
# read over HTTP Range. Empty: no basemap, the map draws its features on a plain
# background (a fresh clone, CI). After `pnpm dev:tiles:fetch`, put the URL
# `pnpm dev:tiles:env` prints in .env.development.local.
PUBLIC_TILES_URL=
