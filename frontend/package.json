{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@water-management/frontend",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev --port 7777",
		"build": "vite build",
		"preview": "vite preview --port 8888",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"prepare": "svelte-kit sync || echo 'svelte-kit sync failed; pnpm check or pnpm test will run it again'",
		"test": "svelte-kit sync && vitest run",
		"test:coverage": "svelte-kit sync && vitest run --coverage",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "24.19.2",
		"@vitest/coverage-v8": "^5.0.5",
		"@xmldom/xmldom": "0.9.12",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"typescript": "6.0.3",
		"vite": "8.3.5",
		"vitest": "^5.0.5",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
	},
	"type": "module",
	"dependencies": {
		"@tmcw/togeojson": "7.1.3",
		"@water-management/engine": "workspace:*",
		"maplibre-gl": "6.16.0",
		"parsedbf": "2.0.0",
		"pmtiles": "4.5.0",
		"proj4": "2.22.0",
		"uplot": "1.6.32",
		"uqr": "0.1.3"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
