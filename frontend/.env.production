# Production build default: CloudFront proxies same-origin /api/* to the Lambda
# Function URL. The deploy workflow may override this via the environment.
PUBLIC_API_URL=/api
# The sign-in CAPTCHA: empty here; the deploy workflow sets both from
# Terraform outputs (waf_captcha_script_url, waf_captcha_api_key).
PUBLIC_WAF_CAPTCHA_SCRIPT_URL=
PUBLIC_WAF_CAPTCHA_API_KEY=
# The catchment map's basemap (docs/maps.md § Basemap): empty until the tiles are
# deployed same-origin under /tiles/ (the CloudFront behaviour is a follow-up).
PUBLIC_TILES_URL=
# The basemap's labels (docs/maps.md § Labels): empty until the fonts are deployed
# same-origin under /tiles/fonts/ (then /tiles/fonts/{fontstack}/{range}.pbf).
PUBLIC_TILES_GLYPHS_URL=
# The map's relief (docs/maps.md § Relief): empty until the DEM tiles are
# deployed same-origin under /tiles/ (then /tiles/terrain.pmtiles).
PUBLIC_TERRAIN_URL=
