# Production build default: CloudFront proxies same-origin /api/* to the Lambda
# Function URL. The deploy workflow may override this via the environment.
PUBLIC_API_URL=/api
# The sign-in CAPTCHA: empty here; the deploy workflow sets both from
# Terraform outputs (waf_captcha_script_url, waf_captcha_api_key).
PUBLIC_WAF_CAPTCHA_SCRIPT_URL=
PUBLIC_WAF_CAPTCHA_API_KEY=
