# Local-dev defaults for the backend. COMMITTED and loaded automatically by
# `pnpm dev` — a fresh clone runs with no setup. Non-sensitive values only
# (localhost URLs, ports, dev-only flags). Real production secrets live in the
# private infra-secrets repo (never here); machine-local real values go in a
# gitignored .env.development.local (loaded first, so it wins).

# Comma-separated list of origins allowed to call this API.
# In prod, set this to your CloudFront domain (e.g. https://example.com).
ALLOWED_ORIGINS=http://localhost:7777

# Public URL of the site — used to build links in emails.
SITE_URL=http://localhost:7777

# Port for local dev server.
PORT=3001

# Shared secret between CloudFront and the Lambda. In prod, Terraform
# generates a random value (random_password.cloudfront_shared_secret) and
# wires it both into the Lambda env AND the CloudFront origin custom_header,
# so every /api/* request CloudFront proxies carries the header. Direct
# hits to the Function URL fail the check.
#
# For local dev, LEAVE THIS EMPTY — the middleware skips the check when
# CLOUDFRONT_SHARED_SECRET is unset, which is correct because the dev
# frontend hits the dev backend directly (no CloudFront in the path).
CLOUDFRONT_SHARED_SECRET=

# Local docker Postgres (`pnpm dev:db:up`, port 5434). DEV-ONLY throwaway
# credentials from docker-compose.yml. The app connects as water_app, which is
# bound by row-level security; migrations run as the schema owner.
DATABASE_URL=postgresql://water_app:water_app@127.0.0.1:5434/water
MIGRATION_DATABASE_URL=postgresql://water:water@127.0.0.1:5434/water

# Signs session tokens. DEV-ONLY value — production gets a random secret from
# infra-secrets. Must be at least 32 characters.
AUTH_JWT_SECRET=dev-only-jwt-secret-change-me-0000000000

# Session cookie `Secure` flag. Local dev is plain http, so off here; every
# deployed environment is https and leaves this unset (Secure on).
COOKIE_SECURE=false

# Outgoing email (src/mail/transport.ts): log | smtp | ses. Local dev sends to
# Mailpit from docker-compose (`pnpm dev:mail:up`, inbox at
# http://localhost:8026). Without Mailpit running, sends fail with a logged
# error and the request still succeeds; set MAIL_TRANSPORT=log in
# .env.development.local to print emails to the console instead.
# Production uses MAIL_TRANSPORT=ses (docs/deployment.md § Email).
MAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
MAIL_FROM=Water Management <no-reply@localhost>

# Alert emails (src/alerts/, docs/run-locally.md § Alerts). The worker sends
# them (pnpm dev:full or dev:run:worker) to Mailpit like every other email.
# ALERTS_TOKEN_SECRET signs the one-click unsubscribe links: DEV-ONLY value,
# production gets a random one from Terraform (infra/jobs.tf). API_PUBLIC_URL
# is where a mail client posts the RFC 8058 one-click unsubscribe (in
# production SITE_URL/api, the default). ALERTS_ENABLED=false is the kill
# switch; ALERTS_DAILY_CAP the immediate mails per person per day (then the
# 06:00 digest).
ALERTS_TOKEN_SECRET=dev-only-alerts-token-secret-000000000
API_PUBLIC_URL=http://localhost:3001
ALERTS_ENABLED=true
ALERTS_DAILY_CAP=5

# Runs kept per project: after each new run the oldest beyond this are deleted
# with their outputs (src/runs/execute.ts). Same as the code default.
RUNS_KEPT_PER_PROJECT=20

# Background jobs (src/jobs/transport.ts): inprocess | memory | sqs. The local
# worker (`pnpm dev:run:worker`, or `pnpm dev:full`) polls the job table every
# JOB_POLL_SECONDS and wakes early on LISTEN job_queued. Postgres only, no AWS;
# production uses JOB_TRANSPORT=sqs (docs/deployment.md § Background jobs).
JOB_TRANSPORT=inprocess
JOB_POLL_SECONDS=15

# Server-side PDF reports (src/reports/, docs/run-locally.md § Reports). The
# worker renders the report route in the Chromium Playwright installed
# (`pnpm test:e2e:install`) against the dev site and API below, and stores the
# PDF in MinIO from docker-compose (`pnpm dev:s3:up`, console
# http://localhost:9003). STORAGE=local is also the code default; production
# uses STORAGE=s3 and REPORT_RENDERER=sqs (docs/deployment.md § Reports).
REPORT_RENDERER=inline
RENDER_SITE_URL=http://localhost:7777
RENDER_API_URL=http://localhost:3001
STORAGE=local
REPORTS_BUCKET=water-reports
# Issued evidence packs' files: the PDF (the renderer's, src/evidence/packPdf.ts)
# and the reproduction bundle (stored by the API when a pack is issued,
# src/evidence/bundle.ts). Their own bucket, created on first use in MinIO like
# the reports one. Production's is kept for good under Object Lock
# (infra/packs.tf, docs/deployment.md § Evidence packs).
PACKS_BUCKET=water-packs
# Downloads are pre-signed MinIO GETs (the code default). Production signs
# CloudFront URLs on the site's /reports/* path instead (REPORT_DOWNLOADS=
# cloudfront, docs/security.md § Reports).
REPORT_DOWNLOADS=presigned
S3_ENDPOINT=http://127.0.0.1:9002
# DEV-ONLY: MinIO's documented default root login, for the throwaway local
# container only (docker-compose.yml).
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
