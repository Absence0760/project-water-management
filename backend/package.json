{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@water-management/backend",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch --include './migrations/*.sql' scripts/dev-server.ts",
		"worker": "tsx src/jobs/worker.ts",
		"jobs:tick": "tsx src/jobs/worker.ts --once",
		"feeds:run": "tsx src/jobs/worker.ts --once --all-feeds",
		"mail:bounce": "tsx scripts/mail-bounce.ts",
		"authority:confirm": "tsx scripts/authority-confirm.ts",
		"build": "esbuild src/lambda.ts --external:playwright-core --bundle --platform=node --target=node24 --format=esm --minify --keep-names --sourcemap --outfile=dist/lambda.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
		"check": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run --project unit",
		"test:coverage": "vitest run --project unit --coverage",
		"test:db:coverage": "vitest run --project db --coverage --coverage.reportsDirectory=coverage/db",
		"test:watch": "vitest",
		"test:db": "vitest run --project db",
		"test:perf": "vitest run --project perf",
		"test:perf:db": "vitest run --project perf-db",
		"test:v8-osr": "tsx scripts/v8-osr-stress.ts",
		"db:migrate": "tsx scripts/migrate-cli.ts",
		"db:psql": "tsx scripts/db-psql.ts",
		"import:project": "tsx scripts/import-project.ts",
		"seed:examples": "tsx scripts/seed-examples.ts",
		"gen:example": "tsx scripts/example-file.ts",
		"pan-sensitivity": "tsx scripts/pan-sensitivity.ts",
		"fit-sweep": "tsx scripts/fit-sweep.ts",
		"list:ewr-rules": "tsx scripts/ewr-rules.ts",
		"reproduce:pack": "tsx ../scripts/reproduce-pack/reproduce-pack.ts",
		"import:quaternaries": "tsx scripts/import-quaternaries.ts",
		"import:gauge-stations": "tsx scripts/import-gauge-stations.ts",
		"import:evaporation-stations": "tsx scripts/import-evaporation-stations.ts",
		"import:rivers": "tsx scripts/import-rivers.ts",
		"import:dam-register": "tsx scripts/import-dam-register.ts",
		"gen:dem-fixture": "tsx scripts/dem-fixture.ts",
		"gen:water-fixture": "tsx scripts/water-fixture.ts",
		"gen:waterbodies-fixture": "tsx scripts/waterbodies-fixture.ts",
		"gen:mirror-fixture": "tsx scripts/gen-mirror-fixture.ts",
		"import:land-cover": "tsx scripts/import-land-cover.ts",
		"import:crop-types": "tsx scripts/import-crop-types.ts",
		"import:evaporation": "tsx scripts/import-evaporation.ts",
		"import:map-grid": "tsx scripts/import-map-grid.ts",
		"import:gazetteer": "tsx scripts/import-gazetteer.ts",
		"import:dws": "tsx scripts/import-dws.ts",
		"import:waterbodies": "tsx scripts/import-waterbodies.ts",
		"import:soils": "tsx scripts/import-soils.ts",
		"import:gr4j-donors": "tsx scripts/import-gr4j-donors.ts",
		"fit-donors": "tsx scripts/fit-donors.ts",
		"dams:run": "tsx scripts/dams-run.ts"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "0.135.0",
		"@aws-sdk/client-bedrock-runtime": "3.1154.0",
		"@aws-sdk/client-s3": "3.1154.0",
		"@aws-sdk/client-sesv2": "3.1154.0",
		"@aws-sdk/client-sqs": "3.1154.0",
		"@aws-sdk/s3-request-presigner": "3.1154.0",
		"@water-management/engine": "workspace:*",
		"@zarrita/storage": "0.2.0",
		"bcryptjs": "3.0.3",
		"dotenv": "^18.0.7",
		"hono": "4.13.13",
		"jose": "6.2.13",
		"nodemailer": "10.1.7",
		"pg": "8.23.1",
		"playwright-core": "1.64.1",
		"zarrita": "0.7.5",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@hono/node-server": "2.1.5",
		"@types/aws-lambda": "8.10.164",
		"@types/node": "24.19.2",
		"@types/nodemailer": "8.0.2",
		"@types/pg": "8.23.1",
		"@vitest/coverage-v8": "^5.0.5",
		"esbuild": "0.28.2",
		"h5wasm": "0.10.3",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"vitest": "^5.0.5"
	}
}
